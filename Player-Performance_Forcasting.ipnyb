ophet/stan_model/prophet_model.bin', 'random', 'seed=88657', 'data', 'file=/tmp/tmpl71otz8y/79cscm07.json', 'init=/tmp/tmpl71otz8y/hutpv29s.json', 'output', 'file=/tmp/tmpl71otz8y/prophet_modelmvj7zlh4/prophet_model-20250429030952.csv', 'method=optimize', 'algorithm=newton', 'iter=10000']\n","03:09:52 - cmdstanpy - INFO - Chain [1] start processing\n","INFO:cmdstanpy:Chain [1] start processing\n","03:09:52 - cmdstanpy - INFO - Chain [1] done processing\n","INFO:cmdstanpy:Chain [1] done processing\n"]},{"output_type":"stream","name":"stdout","text":["Prophet forecast for next 2 matches: [7.68449121 9.66718722]\n","\n","Processing Mwila Phiri (ID: 32)...\n","Training Prophet for player: Mwila Phiri...\n"]},{"output_type":"stream","name":"stderr","text":["INFO:prophet:n_changepoints greater than number of observations. Using 1.\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/sejhwtr8.json\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/eu299tsb.json\n","DEBUG:cmdstanpy:idx 0\n","DEBUG:cmdstanpy:running CmdStan, num_threads: None\n","DEBUG:cmdstanpy:CmdStan args: ['/usr/local/lib/python3.11/dist-packages/prophet/stan_model/prophet_model.bin', 'random', 'seed=3123', 'data', 'file=/tmp/tmpl71otz8y/sejhwtr8.json', 'init=/tmp/tmpl71otz8y/eu299tsb.json', 'output', 'file=/tmp/tmpl71otz8y/prophet_model68mg0ltd/prophet_model-20250429030952.csv', 'method=optimize', 'algorithm=newton', 'iter=10000']\n","03:09:52 - cmdstanpy - INFO - Chain [1] start processing\n","INFO:cmdstanpy:Chain [1] start processing\n","03:09:52 - cmdstanpy - INFO - Chain [1] done processing\n","INFO:cmdstanpy:Chain [1] done processing\n"]},{"output_type":"stream","name":"stdout","text":["Prophet forecast for next 2 matches: [13.8466374 14.8414774]\n","\n","Processing Steven Mukwala (ID: 33)...\n","Training Prophet for player: Steven Mukwala...\n"]},{"output_type":"stream","name":"stderr","text":["INFO:prophet:n_changepoints greater than number of observations. Using 1.\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/woqq31c1.json\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/37xhc1go.json\n","DEBUG:cmdstanpy:idx 0\n","DEBUG:cmdstanpy:running CmdStan, num_threads: None\n","DEBUG:cmdstanpy:CmdStan args: ['/usr/local/lib/python3.11/dist-packages/prophet/stan_model/prophet_model.bin', 'random', 'seed=97803', 'data', 'file=/tmp/tmpl71otz8y/woqq31c1.json', 'init=/tmp/tmpl71otz8y/37xhc1go.json', 'output', 'file=/tmp/tmpl71otz8y/prophet_modelbroz9kyn/prophet_model-20250429030952.csv', 'method=optimize', 'algorithm=newton', 'iter=10000']\n","03:09:52 - cmdstanpy - INFO - Chain [1] start processing\n","INFO:cmdstanpy:Chain [1] start processing\n","03:09:53 - cmdstanpy - INFO - Chain [1] done processing\n","INFO:cmdstanpy:Chain [1] done processing\n"]},{"output_type":"stream","name":"stdout","text":["Prophet forecast for next 2 matches: [11.62820268  9.63356268]\n","\n","Summary of Prophet RMSE across players:\n","        full_name  Prophet_RMSE\n","  Vladyslav Vanat     15.033296\n","Seifeddine Jaziri      3.523203\n","      Cédric Ondo     15.219602\n","    Mohamed Salem     17.262677\n","     Thabo Nodada      9.867107\n","   Stanley Ratifo     12.056885\n","   Cheick Doumbia      4.648226\n","        Abba Bala      9.378558\n","      Mwila Phiri     10.604396\n","   Steven Mukwala      2.031141\n","\n","Average Prophet RMSE across players: 9.9625\n","Results saved to /content/tactic_sense/multi_player_prophet_results.csv\n"]}]},{"cell_type":"markdown","source":["Cell 6: Handle Zero-Variance Players"],"metadata":{"id":"SgIwqdZeQ0z2"}},{"cell_type":"code","source":["print(\"\\nForecasting goals for zero-variance players...\", flush=True)\n","zero_variance_players = player_stats[player_stats['form_score'] <= 1e-5]['player_id'].values\n","\n","if len(zero_variance_players) > 0:\n","    sample_zero_player_id = zero_variance_players[0]  # Take first zero-variance player\n","    zero_player_ts = ts_df[ts_df['player_id'] == sample_zero_player_id].sort_values('date')\n","    player_name = zero_player_ts['full_name'].iloc[0]\n","\n","    print(f\"Processing {player_name} (ID: {sample_zero_player_id}) for goals forecasting...\", flush=True)\n","    # Prepare data for Prophet (forecast goals instead of form_score)\n","    df_prophet = zero_player_ts[['date', 'goals', 'fitness_level', 'injury_history']].rename(\n","        columns={'date': 'ds', 'goals': 'y', 'fitness_level': 'fitness_level', 'injury_history': 'injury_history'}\n","    )\n","\n","    # Check for variance\n","    if df_prophet['y'].std() < 1e-5:\n","        print(f\"Warning: Goals have near-zero variance for {player_name}. Skipping.\", flush=True)\n","    else:\n","        try:\n","            # Initialize Prophet\n","            model = Prophet(\n","                growth='linear',\n","                yearly_seasonality=False,\n","                weekly_seasonality=False,\n","                daily_seasonality=False\n","            )\n","            model.add_regressor('fitness_level')\n","            model.add_regressor('injury_history')\n","            model.fit(df_prophet)\n","\n","            # Create future dataframe\n","            future = model.make_future_dataframe(periods=2, freq='W')\n","            future['fitness_level'] = df_prophet['fitness_level'].iloc[-1]\n","            future['injury_history'] = df_prophet['injury_history'].iloc[-1]\n","\n","            # Forecast\n","            forecast = model.predict(future)\n","            forecast_values = np.maximum(forecast['yhat'].values[-2:], 0)\n","\n","            # Print forecast\n","            print(f\"Prophet goals forecast for {player_name}: {forecast_values}\", flush=True)\n","\n","            # Save model\n","            joblib.dump(model, f'/content/tactic_sense/prophet_goals_model_{sample_zero_player_id}.pkl')\n","            print(f\"Prophet goals model saved to /content/tactic_sense/prophet_goals_model_{sample_zero_player_id}.pkl\", flush=True)\n","        except Exception as e:\n","            print(f\"Prophet failed for {player_name}: {e}\", flush=True)\n","else:\n","    print(\"No zero-variance players found.\", flush=True)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"LN_elT4BQmJL","executionInfo":{"status":"ok","timestamp":1745896201525,"user_tz":-60,"elapsed":44,"user":{"displayName":"Mouheb Hidouri","userId":"07062123680263574832"}},"outputId":"fd6656e0-11aa-4d0b-9cb1-cf9b5d32af93"},"execution_count":66,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Forecasting goals for zero-variance players...\n","Processing Mamadou Diop (ID: 1) for goals forecasting...\n","Warning: Goals have near-zero variance for Mamadou Diop. Skipping.\n"]}]},{"cell_type":"markdown","source":["##Cell 7: Explore Additional Data"],"metadata":{"id":"rbB32NFtRKzM"}},{"cell_type":"code","source":["print(\"\\nExploring additional data...\", flush=True)\n","data_path = '/content/tactic_sense/'\n","\n","# List all available files\n","print(\"Available files in /content/tactic_sense/:\")\n","!ls /content/tactic_sense/\n","\n","# Try loading potentially relevant CSVs\n","for file_name in ['player_club_recommendations.csv', 'pairs_df.csv', 'player_agent_dataset.csv']:\n","    file_path = os.path.join(data_path, file_name)\n","    try:\n","        df = pd.read_csv(file_path)\n","        print(f\"\\n{file_name} loaded. Columns: {df.columns.tolist()}\", flush=True)\n","        print(f\"Shape: {df.shape}\", flush=True)\n","        print(f\"Sample rows:\\n{df.head().to_string()}\", flush=True)\n","        # Check for time-series or match-related columns\n","        time_cols = [col for col in df.columns if 'date' in col.lower() or 'match' in col.lower() or 'performance' in col.lower()]\n","        if time_cols:\n","            print(f\"Potential time-series columns: {time_cols}\", flush=True)\n","        else:\n","            print(\"No obvious time-series or match-related columns found.\", flush=True)\n","    except Exception as e:\n","        print(f\"Failed to load {file_name}: {e}\", flush=True)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"g0A_aYYZQ3Mc","executionInfo":{"status":"ok","timestamp":1745896235694,"user_tz":-60,"elapsed":118,"user":{"displayName":"Mouheb Hidouri","userId":"07062123680263574832"}},"outputId":"a0dbf4e1-50dc-4cf4-f5e6-6d26c43d25f7"},"execution_count":67,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Exploring additional data...\n","Available files in /content/tactic_sense/:\n","arima_model_24.pkl\t\t\t   lstm_scaler_25.pkl\n","arima_model_25.pkl\t\t\t   lstm_scaler_26.pkl\n","arima_model_26.pkl\t\t\t   lstm_scaler_27.pkl\n","arima_model_27.pkl\t\t\t   lstm_scaler_28.pkl\n","arima_model_28.pkl\t\t\t   lstm_scaler_29.pkl\n","arima_model_29.pkl\t\t\t   lstm_scaler_30.pkl\n","arima_model_30.pkl\t\t\t   lstm_scaler_31.pkl\n","arima_model_31.pkl\t\t\t   lstm_scaler_32.pkl\n","arima_model_32.pkl\t\t\t   lstm_scaler_33.pkl\n","arima_model_33.pkl\t\t\t   multi_player_prophet_results.csv\n","Cédric_Ondo_forecast_plot.png\t\t   prophet_model_24.pkl\n","ensemble_forecast_results.csv\t\t   prophet_model_25.pkl\n","final_ensemble_results_new_form_score.csv  prophet_model_26.pkl\n","lstm_model_24.pth\t\t\t   prophet_model_27.pkl\n","lstm_model_25.pth\t\t\t   prophet_model_28.pkl\n","lstm_model_26.pth\t\t\t   prophet_model_29.pkl\n","lstm_model_27.pth\t\t\t   prophet_model_30.pkl\n","lstm_model_28.pth\t\t\t   prophet_model_31.pkl\n","lstm_model_29.pth\t\t\t   prophet_model_32.pkl\n","lstm_model_30.pth\t\t\t   prophet_model_33.pkl\n","lstm_model_31.pth\t\t\t   prophet_model.pkl\n","lstm_model_32.pth\t\t\t   Seifeddine_Jaziri_forecast_plot.png\n","lstm_model_33.pth\t\t\t   Vladyslav_Vanat_forecast_plot.png\n","lstm_scaler_24.pkl\n","Failed to load player_club_recommendations.csv: [Errno 2] No such file or directory: '/content/tactic_sense/player_club_recommendations.csv'\n","Failed to load pairs_df.csv: [Errno 2] No such file or directory: '/content/tactic_sense/pairs_df.csv'\n","Failed to load player_agent_dataset.csv: [Errno 2] No such file or directory: '/content/tactic_sense/player_agent_dataset.csv'\n"]}]},{"cell_type":"markdown","source":["Cell 8: Final Results and Deployment Considerations\n"],"metadata":{"id":"CnfmMVMHRhRP"}},{"cell_type":"code","source":["print(\"\\nFinal Results and Deployment Considerations\", flush=True)\n","\n","# Summarize Prophet performance\n","if 'results_df' in globals() and not results_df.empty:\n","    print(\"\\nProphet Performance Summary:\")\n","    print(f\"Average RMSE across {len(results_df)} players: {results_df['Prophet_RMSE'].mean():.4f}\")\n","    print(\"Top 5 players by lowest RMSE:\")\n","    print(results_df[['full_name', 'Prophet_RMSE']].sort_values('Prophet_RMSE').head().to_string(index=False), flush=True)\n","else:\n","    print(\"\\nNo Prophet results available.\", flush=True)\n","\n","# Recommendations for deployment\n","print(\"\\nDeployment Considerations:\")\n","print(\"- **Model**: Prophet with linear growth, no seasonality, and fitness_level/injury_history regressors.\")\n","print(\"- **Data Updates**: Retrain weekly with new match data to capture recent performance.\")\n","print(\"- **Zero-Variance Players**: Forecast goals/assists directly or exclude from analysis.\")\n","print(\"- **Scalability**: Loop over all player_ids in ts_df for full roster predictions.\")\n","print(\"- **Additional Data**: Integrate match logs from other CSVs (if found) for richer time series.\")\n","print(\"- **Output**: Save predictions as CSV for integration into scouting or coaching systems.\")\n","print(\"- **Monitoring**: Track RMSE over time to detect model drift.\")\n","\n","# Save final notebook state\n","print(\"\\nSaving final time-series dataset and results...\")\n","ts_df.to_csv('/content/tactic_sense/final_player_time_series.csv', index=False)\n","if 'results_df' in globals():\n","    results_df.to_csv('/content/tactic_sense/final_prophet_results.csv', index=False)\n","print(\"Final datasets saved to /content/tactic_sense/\", flush=True)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"WeHsKurzRHX3","executionInfo":{"status":"ok","timestamp":1745896247116,"user_tz":-60,"elapsed":3673,"user":{"displayName":"Mouheb Hidouri","userId":"07062123680263574832"}},"outputId":"08532766-90ad-4c27-d41f-2da37768d634"},"execution_count":68,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Final Results and Deployment Considerations\n","\n","Prophet Performance Summary:\n","Average RMSE across 10 players: 9.9625\n","Top 5 players by lowest RMSE:\n","        full_name  Prophet_RMSE\n","   Steven Mukwala      2.031141\n","Seifeddine Jaziri      3.523203\n","   Cheick Doumbia      4.648226\n","        Abba Bala      9.378558\n","     Thabo Nodada      9.867107\n","\n","Deployment Considerations:\n","- **Model**: Prophet with linear growth, no seasonality, and fitness_level/injury_history regressors.\n","- **Data Updates**: Retrain weekly with new match data to capture recent performance.\n","- **Zero-Variance Players**: Forecast goals/assists directly or exclude from analysis.\n","- **Scalability**: Loop over all player_ids in ts_df for full roster predictions.\n","- **Additional Data**: Integrate match logs from other CSVs (if found) for richer time series.\n","- **Output**: Save predictions as CSV for integration into scouting or coaching systems.\n","- **Monitoring**: Track RMSE over time to detect model drift.\n","\n","Saving final time-series dataset and results...\n","Final datasets saved to /content/tactic_sense/\n"]}]},{"cell_type":"markdown","source":["Cell 9: ARIMA Forecasting for Form Score"],"metadata":{"id":"uCc30-D6iaQH"}},{"cell_type":"code","source":["import pandas as pd\n","import numpy as np\n","from statsmodels.tsa.arima.model import ARIMA\n","from sklearn.metrics import mean_squared_error\n","import joblib\n","\n","def train_arima(player_ts, forecast_steps=2):\n","    print(f\"Training ARIMA for player: {player_ts['full_name'].iloc[0]}...\", flush=True)\n","    train_data = player_ts['form_score'].values[:3]  # First 3 matches\n","    test_data = player_ts['form_score'].values[3:]   # Last 2 matches\n","\n","    if np.std(train_data) < 1e-5:\n","        print(\"Warning: Form score has near-zero variance. Skipping ARIMA.\", flush=True)\n","        return None, None\n","\n","    try:\n","        model = ARIMA(train_data, order=(1,1,0))  # Simple ARIMA model\n","        model_fit = model.fit()\n","        forecast = model_fit.forecast(steps=forecast_steps)\n","        forecast = np.maximum(forecast, 0)  # Ensure non-negative\n","        rmse = np.sqrt(mean_squared_error(test_data, forecast)) if len(test_data) == forecast_steps else None\n","        print(f\"ARIMA forecast for next {forecast_steps} matches: {forecast}, RMSE: {rmse}\", flush=True)\n","        return forecast, model_fit\n","    except Exception as e:\n","        print(f\"ARIMA failed: {e}\", flush=True)\n","        return None, None\n","\n","# Update results for multiple players\n","for player_id in player_ids:\n","    player_ts = ts_df[ts_df['player_id'] == player_id].sort_values('date')\n","    player_name = player_ts['full_name'].iloc[0]\n","    arima_forecast, arima_model = train_arima(player_ts)\n","    if arima_forecast is not None:\n","        results_df.loc[results_df['player_id'] == player_id, 'ARIMA_Predicted'] = str(arima_forecast.tolist())\n","        results_df.loc[results_df['player_id'] == player_id, 'ARIMA_RMSE'] = np.sqrt(\n","            mean_squared_error(player_ts['form_score'].values[3:], arima_forecast)\n","        )\n","        joblib.dump(arima_model, f'/content/tactic_sense/arima_model_{player_id}.pkl')\n","        print(f\"ARIMA model saved for {player_name} to /content/tactic_sense/arima_model_{player_id}.pkl\", flush=True)\n","\n","# Save updated results\n","results_df.to_csv('/content/tactic_sense/multi_player_arima_results.csv', index=False)\n","print(\"ARIMA results saved to /content/tactic_sense/multi_player_arima_results.csv\", flush=True)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"8vyO9iSlc2Iq","executionInfo":{"status":"ok","timestamp":1745896473889,"user_tz":-60,"elapsed":1645,"user":{"displayName":"Mouheb Hidouri","userId":"07062123680263574832"}},"outputId":"c43f26a7-ff37-4c57-f53e-4839673eb5f7"},"execution_count":69,"outputs":[{"output_type":"stream","name":"stdout","text":["Training ARIMA for player: Vladyslav Vanat...\n","ARIMA forecast for next 2 matches: [11.00961766  4.94903361], RMSE: 8.095253075147545\n","ARIMA model saved for Vladyslav Vanat to /content/tactic_sense/arima_model_24.pkl\n","Training ARIMA for player: Seifeddine Jaziri...\n","ARIMA forecast for next 2 matches: [8.40000888 7.12002308], RMSE: 3.17288807703242\n","ARIMA model saved for Seifeddine Jaziri to /content/tactic_sense/arima_model_25.pkl\n","Training ARIMA for player: Cédric Ondo...\n","ARIMA forecast for next 2 matches: [12.34479085  9.1985896 ], RMSE: 8.782072217392544\n","ARIMA model saved for Cédric Ondo to /content/tactic_sense/arima_model_26.pkl\n","Training ARIMA for player: Mohamed Salem...\n","ARIMA forecast for next 2 matches: [0. 0.], RMSE: 17.26267650163207\n","ARIMA model saved for Mohamed Salem to /content/tactic_sense/arima_model_27.pkl\n","Training ARIMA for player: Thabo Nodada...\n","ARIMA forecast for next 2 matches: [15.38464153  8.56802521], RMSE: 10.9256063203907\n","ARIMA model saved for Thabo Nodada to /content/tactic_sense/arima_model_28.pkl\n","Training ARIMA for player: Stanley Ratifo...\n","ARIMA forecast for next 2 matches: [23.19999554 25.75998841], RMSE: 12.82609280228996\n","ARIMA model saved for Stanley Ratifo to /content/tactic_sense/arima_model_29.pkl\n","Training ARIMA for player: Cheick Doumbia...\n","ARIMA forecast for next 2 matches: [4. 4.], RMSE: 5.0990195135927845\n","ARIMA model saved for Cheick Doumbia to /content/tactic_sense/arima_model_30.pkl\n","Training ARIMA for player: Abba Bala...\n","ARIMA forecast for next 2 matches: [7.20002014 4.63998792], RMSE: 12.517380252265914\n","ARIMA model saved for Abba Bala to /content/tactic_sense/arima_model_31.pkl\n","Training ARIMA for player: Mwila Phiri...\n","ARIMA forecast for next 2 matches: [ 6.24388345 15.76206446], RMSE: 13.10771693230592\n","ARIMA model saved for Mwila Phiri to /content/tactic_sense/arima_model_32.pkl\n","Training ARIMA for player: Steven Mukwala...\n","ARIMA forecast for next 2 matches: [10.70580978 15.37721812], RMSE: 2.4396485105541084\n","ARIMA model saved for Steven Mukwala to /content/tactic_sense/arima_model_33.pkl\n","ARIMA results saved to /content/tactic_sense/multi_player_arima_results.csv\n"]}]},{"cell_type":"markdown","source":["LSTM Forecasting for Form Score"],"metadata":{"id":"Ipp0NPKtiijz"}},{"cell_type":"code","source":["import torch\n","import torch.nn as nn\n","import torch.optim as optim\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.metrics import mean_squared_error\n","import numpy as np\n","import joblib\n","\n","class LSTMModel(nn.Module):\n","    def __init__(self, input_size, hidden_size, num_layers):\n","        super(LSTMModel, self).__init__()\n","        self.lstm = nn.LSTM(input_size, hidden_size, num_layers, batch_first=True)\n","        self.fc = nn.Linear(hidden_size, 1)\n","\n","    def forward(self, x):\n","        _, (hn, _) = self.lstm(x)\n","        out = self.fc(hn[-1])\n","        return out\n","\n","def train_lstm(player_ts, sequence_length=3, forecast_steps=2):\n","    print(f\"Training LSTM for player: {player_ts['full_name'].iloc[0]}...\", flush=True)\n","    features = player_ts[['form_score', 'fitness_level', 'injury_history']].values\n","    if np.std(features[:, 0]) < 1e-5:\n","        print(\"Warning: Form score has near-zero variance. Skipping LSTM.\", flush=True)\n","        return None, None, None\n","\n","    scaler = StandardScaler()\n","    features_scaled = scaler.fit_transform(features)\n","\n","    X, y = [], []\n","    for i in range(len(features_scaled) - sequence_length):\n","        X.append(features_scaled[i:i+sequence_length])\n","        y.append(features_scaled[i+sequence_length, 0])\n","    X, y = np.array(X), np.array(y)\n","\n","    if len(X) < 1:\n","        print(\"Insufficient data for LSTM.\", flush=True)\n","        return None, None, None\n","\n","    X_tensor = torch.FloatTensor(X)\n","    y_tensor = torch.FloatTensor(y).reshape(-1, 1)\n","\n","    model = LSTMModel(input_size=3, hidden_size=50, num_layers=1)\n","    criterion = nn.MSELoss()\n","    optimizer = optim.Adam(model.parameters(), lr=0.01)\n","\n","    for epoch in range(50):\n","        model.train()\n","        optimizer.zero_grad()\n","        outputs = model(X_tensor)\n","        loss = criterion(outputs, y_tensor)\n","        loss.backward()\n","        optimizer.step()\n","\n","    # Forecast\n","    last_sequence = torch.FloatTensor(features_scaled[-sequence_length:]).unsqueeze(0)  # Shape: [1, sequence_length, features]\n","    model.eval()\n","    with torch.no_grad():\n","        forecast = []\n","        current_seq = last_sequence\n","        for _ in range(forecast_steps):\n","            pred = model(current_seq)\n","            forecast.append(pred.item())\n","            # Create new input with correct dimensions\n","            new_input = np.array([pred.item(), features_scaled[-1, 1], features_scaled[-1, 2]]).reshape(1, 1, -1)  # Shape: [1, 1, features]\n","            # Concatenate along sequence axis (axis 1)\n","            stacked = np.concatenate([current_seq[:, 1:, :].numpy(), new_input], axis=1)  # Shape: [1, sequence_length, features]\n","            current_seq = torch.FloatTensor(stacked)  # Shape: [1, sequence_length, features]\n","\n","    # Inverse transform forecast\n","    forecast = scaler.inverse_transform([[x, features[-1, 1], features[-1, 2]] for x in forecast])[:, 0]\n","    forecast = np.maximum(forecast, 0)\n","    test_actual = player_ts['form_score'].values[3:]\n","    rmse = np.sqrt(mean_squared_error(test_actual, forecast)) if len(test_actual) == len(forecast) else None\n","\n","    print(f\"LSTM forecast for next {forecast_steps} matches: {forecast}, RMSE: {rmse}\", flush=True)\n","    return forecast, model, scaler\n","\n","# Update results for multiple players\n","for player_id in player_ids:\n","    player_ts = ts_df[ts_df['player_id'] == player_id].sort_values('date')\n","    player_name = player_ts['full_name'].iloc[0]\n","    lstm_forecast, lstm_model, scaler = train_lstm(player_ts)\n","    if lstm_forecast is not None:\n","        results_df.loc[results_df['player_id'] == player_id, 'LSTM_Predicted'] = str(lstm_forecast.tolist())\n","        results_df.loc[results_df['player_id'] == player_id, 'LSTM_RMSE'] = np.sqrt(\n","            mean_squared_error(player_ts['form_score'].values[3:], lstm_forecast)\n","        )\n","        torch.save(lstm_model.state_dict(), f'/content/tactic_sense/lstm_model_{player_id}.pth')\n","        joblib.dump(scaler, f'/content/tactic_sense/lstm_scaler_{player_id}.pkl')\n","        print(f\"LSTM model and scaler saved for {player_name} to /content/tactic_sense/\", flush=True)\n","\n","# Save updated results\n","results_df.to_csv('/content/tactic_sense/multi_player_lstm_results.csv', index=False)\n","print(\"LSTM results saved to /content/tactic_sense/multi_player_lstm_results.csv\", flush=True)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"_Kn3ER6riadM","executionInfo":{"status":"ok","timestamp":1745896593040,"user_tz":-60,"elapsed":1648,"user":{"displayName":"Mouheb Hidouri","userId":"07062123680263574832"}},"outputId":"2ce9c662-40b9-40b2-e811-ba09d11648e7"},"execution_count":72,"outputs":[{"output_type":"stream","name":"stdout","text":["Training LSTM for player: Vladyslav Vanat...\n","LSTM forecast for next 2 matches: [16.71971079 14.21784502], RMSE: 2.299228475272638\n","LSTM model and scaler saved for Vladyslav Vanat to /content/tactic_sense/\n","Training LSTM for player: Seifeddine Jaziri...\n","LSTM forecast for next 2 matches: [9.19067496 9.33750474], RMSE: 3.790252332521998\n","LSTM model and scaler saved for Seifeddine Jaziri to /content/tactic_sense/\n","Training LSTM for player: Cédric Ondo...\n","LSTM forecast for next 2 matches: [2.31116571 4.62433422], RMSE: 3.4811369022213134\n","LSTM model and scaler saved for Cédric Ondo to /content/tactic_sense/\n","Training LSTM for player: Mohamed Salem...\n","LSTM forecast for next 2 matches: [14.25324611 15.26241331], RMSE: 4.160460767403901\n","LSTM model and scaler saved for Mohamed Salem to /content/tactic_sense/\n","Training LSTM for player: Thabo Nodada...\n","LSTM forecast for next 2 matches: [2.12901108 0.        ], RMSE: 7.229546602905257\n","LSTM model and scaler saved for Thabo Nodada to /content/tactic_sense/\n","Training LSTM for player: Stanley Ratifo...\n","LSTM forecast for next 2 matches: [ 1.85391848 24.70522056], RMSE: 4.4344724918478216\n","LSTM model and scaler saved for Stanley Ratifo to /content/tactic_sense/\n","Training LSTM for player: Cheick Doumbia...\n","LSTM forecast for next 2 matches: [0.         4.33694932], RMSE: 4.004381540514242\n","LSTM model and scaler saved for Cheick Doumbia to /content/tactic_sense/\n","Training LSTM for player: Abba Bala...\n","LSTM forecast for next 2 matches: [22.15677126 24.81431809], RMSE: 5.5264586761453955\n","LSTM model and scaler saved for Abba Bala to /content/tactic_sense/\n","Training LSTM for player: Mwila Phiri...\n","LSTM forecast for next 2 matches: [14.94679802 16.62673347], RMSE: 11.780439304400693\n","LSTM model and scaler saved for Mwila Phiri to /content/tactic_sense/\n","Training LSTM for player: Steven Mukwala...\n","LSTM forecast for next 2 matches: [11.67362808 12.4898366 ], RMSE: 1.2330796507404187\n","LSTM model and scaler saved for Steven Mukwala to /content/tactic_sense/\n","LSTM results saved to /content/tactic_sense/multi_player_lstm_results.csv\n"]}]},{"cell_type":"markdown","source":["#Ensemble Predicitons"],"metadata":{"id":"HtpdSWvbjIL7"}},{"cell_type":"code","source":["import pandas as pd\n","import numpy as np\n","from sklearn.metrics import mean_squared_error\n","\n","def compute_ensemble(results_df):\n","    print(\"Computing ensemble predictions...\", flush=True)\n","    for idx, row in results_df.iterrows():\n","        try:\n","            # Skip if required columns are missing or invalid\n","            if (row['Prophet_Predicted'] is None or\n","                pd.isna(row.get('ARIMA_RMSE')) or\n","                pd.isna(row.get('LSTM_RMSE'))):\n","                print(f\"Skipping player {row['full_name']} due to missing predictions or RMSE.\", flush=True)\n","                continue\n","\n","            # Convert predictions to arrays, handling different types\n","            def parse_prediction(pred):\n","                if isinstance(pred, str):\n","                    return np.array(eval(pred))\n","                elif isinstance(pred, (list, np.ndarray)):\n","                    return np.array(pred)\n","                else:\n","                    raise ValueError(f\"Invalid prediction format: {pred}\")\n","\n","            prophet_pred = parse_prediction(row['Prophet_Predicted'])\n","            arima_pred = parse_prediction(row.get('ARIMA_Predicted', prophet_pred))\n","            lstm_pred = parse_prediction(row.get('LSTM_Predicted', prophet_pred))\n","\n","            # Compute ensemble as average\n","            ensemble_pred = (prophet_pred + arima_pred + lstm_pred) / 3\n","\n","            # Compute RMSE\n","            test_actual = np.array(eval(row['Test_Actual'])) if isinstance(row['Test_Actual'], str) else np.array(row['Test_Actual'])\n","            rmse = np.sqrt(mean_squared_error(test_actual, ensemble_pred))\n","\n","            # Update results_df\n","            results_df.at[idx, 'Ensemble_Predicted'] = str(ensemble_pred.tolist())\n","            results_df.at[idx, 'Ensemble_RMSE'] = rmse\n","            print(f\"Ensemble for {row['full_name']}: RMSE = {rmse:.4f}\", flush=True)\n","\n","        except Exception as e:\n","            print(f\"Error processing player {row['full_name']}: {e}\", flush=True)\n","            continue\n","\n","    print(\"\\nEnsemble RMSE summary:\")\n","    print(results_df[['full_name', 'Ensemble_RMSE']].to_string(index=False), flush=True)\n","    results_df.to_csv('/content/tactic_sense/final_ensemble_results.csv', index=False)\n","    print(\"Ensemble results saved to /content/tactic_sense/final_ensemble_results.csv\", flush=True)\n","\n","# Run ensemble computation\n","compute_ensemble(results_df)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Uf-nO5ZPiolN","executionInfo":{"status":"ok","timestamp":1745896722250,"user_tz":-60,"elapsed":71,"user":{"displayName":"Mouheb Hidouri","userId":"07062123680263574832"}},"outputId":"4c8e2113-c8df-457a-9948-84b2003fe13e"},"execution_count":76,"outputs":[{"output_type":"stream","name":"stdout","text":["Computing ensemble predictions...\n","Ensemble for Vladyslav Vanat: RMSE = 7.5829\n","Ensemble for Seifeddine Jaziri: RMSE = 3.0985\n","Ensemble for Cédric Ondo: RMSE = 8.6839\n","Ensemble for Mohamed Salem: RMSE = 12.4892\n","Ensemble for Thabo Nodada: RMSE = 7.3551\n","Ensemble for Stanley Ratifo: RMSE = 7.8308\n","Ensemble for Cheick Doumbia: RMSE = 3.9756\n","Ensemble for Abba Bala: RMSE = 5.5578\n","Ensemble for Mwila Phiri: RMSE = 11.5439\n","Ensemble for Steven Mukwala: RMSE = 1.0087\n","\n","Ensemble RMSE summary:\n","        full_name  Ensemble_RMSE\n","  Vladyslav Vanat       7.582879\n","Seifeddine Jaziri       3.098462\n","      Cédric Ondo       8.683890\n","    Mohamed Salem      12.489249\n","     Thabo Nodada       7.355057\n","   Stanley Ratifo       7.830807\n","   Cheick Doumbia       3.975552\n","        Abba Bala       5.557805\n","      Mwila Phiri      11.543950\n","   Steven Mukwala       1.008658\n","Ensemble results saved to /content/tactic_sense/final_ensemble_results.csv\n"]}]},{"cell_type":"code","source":["import pandas as pd\n","import numpy as np\n","from prophet import Prophet\n","from statsmodels.tsa.arima.model import ARIMA\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.metrics import mean_squared_error\n","import torch\n","import torch.nn as nn\n","import torch.optim as optim\n","import joblib\n","\n","# Clean up ts_df by removing redundant columns\n","print(\"Cleaning up ts_df by removing redundant columns...\", flush=True)\n","redundant_cols = [col for col in ts_df.columns if col.endswith('_x') or col.endswith('_y')]\n","ts_df = ts_df.drop(columns=redundant_cols, errors='ignore')\n","print(\"ts_df columns after cleanup:\", ts_df.columns.tolist(), flush=True)\n","\n","# Verify required columns\n","required_cols = ['player_id', 'full_name', 'date', 'form_score', 'goals', 'assists', 'fitness_level', 'injury_history']\n","missing_cols = [col for col in required_cols if col not in ts_df.columns]\n","if missing_cols:\n","    raise KeyError(f\"Missing required columns in ts_df: {missing_cols}\")\n","\n","# Prophet forecasting for additional metrics\n","def train_prophet_metric(player_ts, metric, forecast_steps=2):\n","    print(f\"Training Prophet for {metric} for player: {player_ts['full_name'].iloc[0]}...\", flush=True)\n","    if metric not in player_ts.columns:\n","        print(f\"Warning: {metric} not found in player_ts. Skipping.\", flush=True)\n","        return None\n","    df_prophet = player_ts[['date', metric, 'fitness_level', 'injury_history']].rename(\n","        columns={'date': 'ds', metric: 'y'}\n","    )\n","    if df_prophet['y'].std() < 1e-5:\n","        print(f\"Warning: {metric} has near-zero variance. Skipping.\", flush=True)\n","        return None\n","    try:\n","        model = Prophet(growth='linear', yearly_seasonality=False, weekly_seasonality=False, daily_seasonality=False)\n","        model.add_regressor('fitness_level')\n","        model.add_regressor('injury_history')\n","        model.fit(df_prophet)\n","        future = model.make_future_dataframe(periods=forecast_steps, freq='W')\n","        future['fitness_level'] = df_prophet['fitness_level'].iloc[-1]\n","        future['injury_history'] = df_prophet['injury_history'].iloc[-1]\n","        forecast = model.predict(future)\n","        return np.maximum(forecast['yhat'].values[-forecast_steps:], 0)\n","    except Exception as e:\n","        print(f\"Prophet failed for {metric}: {e}\", flush=True)\n","        return None\n","\n","# ARIMA forecasting for additional metrics\n","def train_arima_metric(player_ts, metric, forecast_steps=2):\n","    print(f\"Training ARIMA for {metric} for player: {player_ts['full_name'].iloc[0]}...\", flush=True)\n","    if metric not in player_ts.columns:\n","        print(f\"Warning: {metric} not found in player_ts. Skipping.\", flush=True)\n","        return None\n","    train_data = player_ts[metric].values[:3]\n","    test_data = player_ts[metric].values[3:]\n","    if np.std(train_data) < 1e-5:\n","        print(f\"Warning: {metric} has near-zero variance. Skipping.\", flush=True)\n","        return None\n","    try:\n","        model = ARIMA(train_data, order=(1,1,0))\n","        model_fit = model.fit()\n","        forecast = model_fit.forecast(steps=forecast_steps)\n","        return np.maximum(forecast, 0)\n","    except Exception as e:\n","        print(f\"ARIMA failed for {metric}: {e}\", flush=True)\n","        return None\n","\n","# LSTM forecasting for additional metrics\n","class LSTMModel(nn.Module):\n","    def __init__(self, input_size, hidden_size, num_layers):\n","        super(LSTMModel, self).__init__()\n","        self.lstm = nn.LSTM(input_size, hidden_size, num_layers, batch_first=True)\n","        self.fc = nn.Linear(hidden_size, 1)\n","\n","    def forward(self, x):\n","        _, (hn, _) = self.lstm(x)\n","        out = self.fc(hn[-1])\n","        return out\n","\n","def train_lstm_metric(player_ts, metric, sequence_length=3, forecast_steps=2):\n","    print(f\"Training LSTM for {metric} for player: {player_ts['full_name'].iloc[0]}...\", flush=True)\n","    if metric not in player_ts.columns:\n","        print(f\"Warning: {metric} not found in player_ts. Skipping.\", flush=True)\n","        return None\n","    features = player_ts[[metric, 'fitness_level', 'injury_history']].values\n","    if np.std(features[:, 0]) < 1e-5:\n","        print(f\"Warning: {metric} has near-zero variance. Skipping.\", flush=True)\n","        return None\n","    scaler = StandardScaler()\n","    features_scaled = scaler.fit_transform(features)\n","    X, y = [], []\n","    for i in range(len(features_scaled) - sequence_length):\n","        X.append(features_scaled[i:i+sequence_length])\n","        y.append(features_scaled[i+sequence_length, 0])\n","    X, y = np.array(X), np.array(y)\n","    if len(X) < 1:\n","        print(f\"Insufficient data for LSTM {metric}. Skipping.\", flush=True)\n","        return None\n","    X_tensor = torch.FloatTensor(X)\n","    y_tensor = torch.FloatTensor(y).reshape(-1, 1)\n","    model = LSTMModel(input_size=3, hidden_size=50, num_layers=1)\n","    criterion = nn.MSELoss()\n","    optimizer = optim.Adam(model.parameters(), lr=0.01)\n","    for epoch in range(50):\n","        model.train()\n","        optimizer.zero_grad()\n","        outputs = model(X_tensor)\n","        loss = criterion(outputs, y_tensor)\n","        loss.backward()\n","        optimizer.step()\n","    last_sequence = torch.FloatTensor(features_scaled[-sequence_length:]).unsqueeze(0)\n","    model.eval()\n","    with torch.no_grad():\n","        forecast = []\n","        current_seq = last_sequence\n","        for _ in range(forecast_steps):\n","            pred = model(current_seq)\n","            forecast.append(pred.item())\n","            new_input = np.array([[pred.item(), features_scaled[-1, 1], features_scaled[-1, 2]]]).reshape(1, 1, 3)\n","            stacked = np.concatenate([current_seq[:, 1:, :].numpy(), new_input], axis=1)\n","            current_seq = torch.FloatTensor(stacked)\n","    forecast = scaler.inverse_transform([[x, features[-1, 1], features[-1, 2]] for x in forecast])[:, 0]\n","    return np.maximum(forecast, 0)\n","\n","# Forecast for additional metrics\n","metrics = ['goals', 'assists']\n","results_metrics = []\n","for metric in metrics:\n","    for player_id in player_ids:\n","        player_ts = ts_df[ts_df['player_id'] == player_id].sort_values('date')\n","        player_name = player_ts['full_name'].iloc[0]\n","        if metric not in player_ts.columns:\n","            print(f\"Warning: {metric} not found for {player_name}. Skipping.\", flush=True)\n","            continue\n","        test_actual = player_ts[metric].values[3:]\n","\n","        prophet_forecast = train_prophet_metric(player_ts, metric)\n","        arima_forecast = train_arima_metric(player_ts, metric)\n","        lstm_forecast = train_lstm_metric(player_ts, metric)\n","\n","        rmse_prophet = np.sqrt(mean_squared_error(test_actual, prophet_forecast)) if prophet_forecast is not None else None\n","        rmse_arima = np.sqrt(mean_squared_error(test_actual, arima_forecast)) if arima_forecast is not None else None\n","        rmse_lstm = np.sqrt(mean_squared_error(test_actual, lstm_forecast)) if lstm_forecast is not None else None\n","\n","        results_metrics.append({\n","            'player_id': player_id,\n","            'full_name': player_name,\n","            'metric': metric,\n","            'Prophet_RMSE': rmse_prophet,\n","            'ARIMA_RMSE': rmse_arima,\n","            'LSTM_RMSE': rmse_lstm,\n","            'Test_Actual': str(test_actual.tolist()),\n","            'Prophet_Predicted': str(prophet_forecast.tolist()) if prophet_forecast is not None else None,\n","            'ARIMA_Predicted': str(arima_forecast.tolist()) if arima_forecast is not None else None,\n","            'LSTM_Predicted': str(lstm_forecast.tolist()) if lstm_forecast is not None else None\n","        })\n","\n","# Save results\n","results_metrics_df = pd.DataFrame(results_metrics)\n","results_metrics_df.to_csv('/content/tactic_sense/additional_metrics_results.csv', index=False)\n","print(\"Additional metrics results saved to /content/tactic_sense/additional_metrics_results.csv\", flush=True)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"U1TB3Eo3jKc0","executionInfo":{"status":"ok","timestamp":1745896945772,"user_tz":-60,"elapsed":7753,"user":{"displayName":"Mouheb Hidouri","userId":"07062123680263574832"}},"outputId":"4da2d3ce-10eb-439e-9c62-7f77268bf800"},"execution_count":79,"outputs":[{"output_type":"stream","name":"stdout","text":["Cleaning up ts_df by removing redundant columns...\n","ts_df columns after cleanup: ['player_id', 'full_name', 'date', 'form_score', 'goals', 'assists', 'fitness_level', 'injury_history', 'new_form_score', 'fatigue_indicator', 'skill_passing']\n","Training Prophet for goals for player: Vladyslav Vanat...\n"]},{"output_type":"stream","name":"stderr","text":["INFO:prophet:n_changepoints greater than number of observations. Using 3.\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/ycal48fy.json\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/l6ltxwnu.json\n","DEBUG:cmdstanpy:idx 0\n","DEBUG:cmdstanpy:running CmdStan, num_threads: None\n","DEBUG:cmdstanpy:CmdStan args: ['/usr/local/lib/python3.11/dist-packages/prophet/stan_model/prophet_model.bin', 'random', 'seed=57039', 'data', 'file=/tmp/tmpl71otz8y/ycal48fy.json', 'init=/tmp/tmpl71otz8y/l6ltxwnu.json', 'output', 'file=/tmp/tmpl71otz8y/prophet_modelwtsf34v3/prophet_model-20250429032215.csv', 'method=optimize', 'algorithm=newton', 'iter=10000']\n","03:22:15 - cmdstanpy - INFO - Chain [1] start processing\n","INFO:cmdstanpy:Chain [1] start processing\n","03:22:15 - cmdstanpy - INFO - Chain [1] done processing\n","INFO:cmdstanpy:Chain [1] done processing\n"]},{"output_type":"stream","name":"stdout","text":["Training ARIMA for goals for player: Vladyslav Vanat...\n","Training LSTM for goals for player: Vladyslav Vanat...\n","Training Prophet for goals for player: Seifeddine Jaziri...\n"]},{"output_type":"stream","name":"stderr","text":["INFO:prophet:n_changepoints greater than number of observations. Using 3.\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/6lfjv3w8.json\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/pmbfqzzx.json\n","DEBUG:cmdstanpy:idx 0\n","DEBUG:cmdstanpy:running CmdStan, num_threads: None\n","DEBUG:cmdstanpy:CmdStan args: ['/usr/local/lib/python3.11/dist-packages/prophet/stan_model/prophet_model.bin', 'random', 'seed=54155', 'data', 'file=/tmp/tmpl71otz8y/6lfjv3w8.json', 'init=/tmp/tmpl71otz8y/pmbfqzzx.json', 'output', 'file=/tmp/tmpl71otz8y/prophet_modelqgs8xfwj/prophet_model-20250429032216.csv', 'method=optimize', 'algorithm=newton', 'iter=10000']\n","03:22:16 - cmdstanpy - INFO - Chain [1] start processing\n","INFO:cmdstanpy:Chain [1] start processing\n","03:22:16 - cmdstanpy - INFO - Chain [1] done processing\n","INFO:cmdstanpy:Chain [1] done processing\n"]},{"output_type":"stream","name":"stdout","text":["Training ARIMA for goals for player: Seifeddine Jaziri...\n","Training LSTM for goals for player: Seifeddine Jaziri...\n","Training Prophet for goals for player: Cédric Ondo...\n"]},{"output_type":"stream","name":"stderr","text":["INFO:prophet:n_changepoints greater than number of observations. Using 3.\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/d4dfv67j.json\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/yrdrr3b5.json\n","DEBUG:cmdstanpy:idx 0\n","DEBUG:cmdstanpy:running CmdStan, num_threads: None\n","DEBUG:cmdstanpy:CmdStan args: ['/usr/local/lib/python3.11/dist-packages/prophet/stan_model/prophet_model.bin', 'random', 'seed=42066', 'data', 'file=/tmp/tmpl71otz8y/d4dfv67j.json', 'init=/tmp/tmpl71otz8y/yrdrr3b5.json', 'output', 'file=/tmp/tmpl71otz8y/prophet_model62kec7j2/prophet_mode