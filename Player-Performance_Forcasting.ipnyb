. Using 3.\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/xxrwvxan.json\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/osyev6p8.json\n","DEBUG:cmdstanpy:idx 0\n","DEBUG:cmdstanpy:running CmdStan, num_threads: None\n","DEBUG:cmdstanpy:CmdStan args: ['/usr/local/lib/python3.11/dist-packages/prophet/stan_model/prophet_model.bin', 'random', 'seed=45663', 'data', 'file=/tmp/tmpl71otz8y/xxrwvxan.json', 'init=/tmp/tmpl71otz8y/osyev6p8.json', 'output', 'file=/tmp/tmpl71otz8y/prophet_modelzh2ha1r1/prophet_model-20250429032858.csv', 'method=optimize', 'algorithm=newton', 'iter=10000']\n","03:28:58 - cmdstanpy - INFO - Chain [1] start processing\n","INFO:cmdstanpy:Chain [1] start processing\n","03:28:58 - cmdstanpy - INFO - Chain [1] done processing\n","INFO:cmdstanpy:Chain [1] done processing\n","INFO:prophet:n_changepoints greater than number of observations. Using 3.\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/jm69tbs2.json\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/fub5q1tj.json\n","DEBUG:cmdstanpy:idx 0\n","DEBUG:cmdstanpy:running CmdStan, num_threads: None\n","DEBUG:cmdstanpy:CmdStan args: ['/usr/local/lib/python3.11/dist-packages/prophet/stan_model/prophet_model.bin', 'random', 'seed=79355', 'data', 'file=/tmp/tmpl71otz8y/jm69tbs2.json', 'init=/tmp/tmpl71otz8y/fub5q1tj.json', 'output', 'file=/tmp/tmpl71otz8y/prophet_modelftaemwy1/prophet_model-20250429032858.csv', 'method=optimize', 'algorithm=newton', 'iter=10000']\n","03:28:58 - cmdstanpy - INFO - Chain [1] start processing\n","INFO:cmdstanpy:Chain [1] start processing\n"]},{"output_type":"stream","name":"stdout","text":["Training Prophet for assists for player: Stanley Ratifo...\n","Predicting with Multivariate LSTM for player: Stanley Ratifo...\n","Training Prophet for goals for player: Vladyslav Vanat...\n"]},{"output_type":"stream","name":"stderr","text":["03:28:58 - cmdstanpy - INFO - Chain [1] done processing\n","INFO:cmdstanpy:Chain [1] done processing\n","INFO:prophet:n_changepoints greater than number of observations. Using 3.\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/bda8kmok.json\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/mwt8dgh9.json\n","DEBUG:cmdstanpy:idx 0\n","DEBUG:cmdstanpy:running CmdStan, num_threads: None\n","DEBUG:cmdstanpy:CmdStan args: ['/usr/local/lib/python3.11/dist-packages/prophet/stan_model/prophet_model.bin', 'random', 'seed=76058', 'data', 'file=/tmp/tmpl71otz8y/bda8kmok.json', 'init=/tmp/tmpl71otz8y/mwt8dgh9.json', 'output', 'file=/tmp/tmpl71otz8y/prophet_modelw1oz3slx/prophet_model-20250429032858.csv', 'method=optimize', 'algorithm=newton', 'iter=10000']\n","03:28:58 - cmdstanpy - INFO - Chain [1] start processing\n","INFO:cmdstanpy:Chain [1] start processing\n","03:28:58 - cmdstanpy - INFO - Chain [1] done processing\n","INFO:cmdstanpy:Chain [1] done processing\n","INFO:prophet:n_changepoints greater than number of observations. Using 3.\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/r6pu49nc.json\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/g1b014md.json\n","DEBUG:cmdstanpy:idx 0\n","DEBUG:cmdstanpy:running CmdStan, num_threads: None\n","DEBUG:cmdstanpy:CmdStan args: ['/usr/local/lib/python3.11/dist-packages/prophet/stan_model/prophet_model.bin', 'random', 'seed=23512', 'data', 'file=/tmp/tmpl71otz8y/r6pu49nc.json', 'init=/tmp/tmpl71otz8y/g1b014md.json', 'output', 'file=/tmp/tmpl71otz8y/prophet_model7fo197mk/prophet_model-20250429032858.csv', 'method=optimize', 'algorithm=newton', 'iter=10000']\n","03:28:58 - cmdstanpy - INFO - Chain [1] start processing\n","INFO:cmdstanpy:Chain [1] start processing\n","03:28:58 - cmdstanpy - INFO - Chain [1] done processing\n","INFO:cmdstanpy:Chain [1] done processing\n"]},{"output_type":"stream","name":"stdout","text":["Training Prophet for assists for player: Vladyslav Vanat...\n","Predicting with Multivariate LSTM for player: Vladyslav Vanat...\n","Training Prophet for goals for player: Abba Bala...\n"]},{"output_type":"stream","name":"stderr","text":["INFO:prophet:n_changepoints greater than number of observations. Using 3.\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/br4w7xca.json\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/wxqre3h9.json\n","DEBUG:cmdstanpy:idx 0\n","DEBUG:cmdstanpy:running CmdStan, num_threads: None\n","DEBUG:cmdstanpy:CmdStan args: ['/usr/local/lib/python3.11/dist-packages/prophet/stan_model/prophet_model.bin', 'random', 'seed=97560', 'data', 'file=/tmp/tmpl71otz8y/br4w7xca.json', 'init=/tmp/tmpl71otz8y/wxqre3h9.json', 'output', 'file=/tmp/tmpl71otz8y/prophet_modelf73zvhdc/prophet_model-20250429032859.csv', 'method=optimize', 'algorithm=newton', 'iter=10000']\n","03:28:59 - cmdstanpy - INFO - Chain [1] start processing\n","INFO:cmdstanpy:Chain [1] start processing\n","03:28:59 - cmdstanpy - INFO - Chain [1] done processing\n","INFO:cmdstanpy:Chain [1] done processing\n"]},{"output_type":"stream","name":"stdout","text":["Training Prophet for assists for player: Abba Bala...\n","Predicting with Multivariate LSTM for player: Abba Bala...\n","\n","Prediction Table for Random Players:\n","|   player_id | full_name         | metric        | model             |   predicted_t+1 |   predicted_t+2 |\n","|------------:|:------------------|:--------------|:------------------|----------------:|----------------:|\n","|          32 | Mwila Phiri       | goals         | Prophet           |          0.9173 |          0.8182 |\n","|          32 | Mwila Phiri       | assists       | Prophet           |          0.0000 |          0.0000 |\n","|          32 | Mwila Phiri       | form_score    | Multivariate LSTM |         15.7071 |         15.0709 |\n","|          32 | Mwila Phiri       | goals         | Multivariate LSTM |          1.9898 |          1.8881 |\n","|          32 | Mwila Phiri       | assists       | Multivariate LSTM |          1.0383 |          0.9712 |\n","|          32 | Mwila Phiri       | fitness_level | Multivariate LSTM |         93.8930 |         93.7634 |\n","|          25 | Seifeddine Jaziri | goals         | Prophet           |          0.0000 |          0.0000 |\n","|          25 | Seifeddine Jaziri | assists       | Prophet           |          1.8543 |          2.1533 |\n","|          25 | Seifeddine Jaziri | form_score    | Multivariate LSTM |         10.5307 |         11.4926 |\n","|          25 | Seifeddine Jaziri | goals         | Multivariate LSTM |          0.2682 |          0.4982 |\n","|          25 | Seifeddine Jaziri | assists       | Multivariate LSTM |          2.2544 |          2.1472 |\n","|          25 | Seifeddine Jaziri | fitness_level | Multivariate LSTM |         90.3297 |         90.3131 |\n","|          29 | Stanley Ratifo    | goals         | Prophet           |          1.8852 |          1.9851 |\n","|          29 | Stanley Ratifo    | assists       | Prophet           |          1.1135 |          1.0139 |\n","|          29 | Stanley Ratifo    | form_score    | Multivariate LSTM |         10.4386 |         15.7441 |\n","|          29 | Stanley Ratifo    | goals         | Multivariate LSTM |          1.3652 |          1.7534 |\n","|          29 | Stanley Ratifo    | assists       | Multivariate LSTM |          0.5774 |          1.4905 |\n","|          29 | Stanley Ratifo    | fitness_level | Multivariate LSTM |         73.8351 |         73.8386 |\n","|          24 | Vladyslav Vanat   | goals         | Prophet           |          1.4921 |          1.5932 |\n","|          24 | Vladyslav Vanat   | assists       | Prophet           |          0.8325 |          0.6335 |\n","|          24 | Vladyslav Vanat   | form_score    | Multivariate LSTM |         13.9678 |         13.8722 |\n","|          24 | Vladyslav Vanat   | goals         | Multivariate LSTM |          1.6008 |          1.2684 |\n","|          24 | Vladyslav Vanat   | assists       | Multivariate LSTM |          1.1242 |          1.3876 |\n","|          24 | Vladyslav Vanat   | fitness_level | Multivariate LSTM |         96.6687 |         96.7182 |\n","|          31 | Abba Bala         | goals         | Prophet           |          2.5048 |          3.1017 |\n","|          31 | Abba Bala         | assists       | Prophet           |          2.0536 |          2.3525 |\n","|          31 | Abba Bala         | form_score    | Multivariate LSTM |         15.5351 |         11.9339 |\n","|          31 | Abba Bala         | goals         | Multivariate LSTM |          1.3723 |          1.0654 |\n","|          31 | Abba Bala         | assists       | Multivariate LSTM |          1.9748 |          1.6580 |\n","|          31 | Abba Bala         | fitness_level | Multivariate LSTM |         85.7475 |         85.6892 |\n","Predictions saved to /content/tactic_sense/random_players_predictions.csv\n"]}]},{"cell_type":"markdown","source":["# Model Testing and Visualization\n","## Purpose:\n","\n","Test the Prophet and Multivariate LSTM models by comparing their predictions against actual test data for form_score, goals, assists, and fitness_level.\n","Visualize the predicted values alongside actual values using time-series and faceted line plots to assess model performance across players and metrics.\n","Summarize prediction trends to guide model interpretation and future improvements."],"metadata":{"id":"nRdne8TFrgm-"}},{"cell_type":"code","source":["%matplotlib inline\n","import pandas as pd\n","import numpy as np\n","from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","import os\n","\n","# Ensure plots directory exists\n","os.makedirs('/content/tactic_sense/plots/', exist_ok=True)\n","\n","# Load time-series data\n","ts_df = pd.read_csv('/content/tactic_sense/player_time_series.csv')\n","ts_df['date'] = pd.to_datetime(ts_df['date'])\n","\n","# Load prediction results\n","predictions_df = pd.read_csv('/content/tactic_sense/random_players_predictions.csv')\n","\n","# Function to compute metrics\n","def compute_metrics(actual, predicted):\n","    if actual is None or predicted is None or len(actual) == 0 or len(predicted) == 0:\n","        return None, None, None\n","    rmse = np.sqrt(mean_squared_error(actual, predicted))\n","    mae = mean_absolute_error(actual, predicted)\n","    r2 = r2_score(actual, predicted) if np.var(actual) > 1e-5 else None\n","    return rmse, mae, r2\n","\n","# Evaluate predictions\n","eval_results = []\n","player_ids = predictions_df['player_id'].unique()\n","\n","for player_id in player_ids:\n","    player_ts = ts_df[ts_df['player_id'] == player_id].sort_values('date')\n","    player_name = player_ts['full_name'].iloc[0]\n","    test_actual = player_ts.iloc[-2:][['form_score', 'goals', 'assists', 'fitness_level']].values\n","    player_predictions = predictions_df[predictions_df['player_id'] == player_id]\n","\n","    for metric in ['form_score', 'goals', 'assists', 'fitness_level']:\n","        metric_idx = ['form_score', 'goals', 'assists', 'fitness_level'].index(metric)\n","        actual = test_actual[:, metric_idx]\n","\n","        for model in ['Prophet', 'Multivariate LSTM']:\n","            model_preds = player_predictions[\n","                (player_predictions['metric'] == metric) & (player_predictions['model'] == model)\n","            ]\n","            if model_preds.empty:\n","                continue\n","            predicted = model_preds[['predicted_t+1', 'predicted_t+2']].values.flatten()\n","            rmse, mae, r2 = compute_metrics(actual, predicted)\n","            eval_results.append({\n","                'player_id': player_id,\n","                'full_name': player_name,\n","                'metric': metric,\n","                'model': model,\n","                'RMSE': rmse,\n","                'MAE': mae,\n","                'R2': r2\n","            })\n","\n","# Create evaluation DataFrame\n","eval_df = pd.DataFrame(eval_results)\n","eval_df.to_csv('/content/tactic_sense/model_testing_results.csv', index=False)\n","print(\"Evaluation results saved to /content/tactic_sense/model_testing_results.csv\", flush=True)\n","print(\"\\nEvaluation Results Summary:\")\n","print(eval_df.groupby(['metric', 'model'])[['RMSE', 'MAE', 'R2']].mean().to_string(), flush=True)\n","\n","# Visualization 1: Time-series plots for each player (focus on predictions)\n","for player_id in player_ids:\n","    player_ts = ts_df[ts_df['player_id'] == player_id].sort_values('date')\n","    player_name = player_ts['full_name'].iloc[0]\n","    player_predictions = predictions_df[predictions_df['player_id'] == player_id]\n","\n","    dates = pd.to_datetime(player_ts['date']).values[-3:]  # Last 3 time steps for context\n","    actual = player_ts[['form_score', 'goals', 'assists', 'fitness_level']].values[-3:]\n","    future_dates = pd.date_range(start=dates[-1], periods=3, freq='W')[1:]\n","\n","    plt.figure(figsize=(15, 12))\n","    for i, metric in enumerate(['form_score', 'goals', 'assists', 'fitness_level']):\n","        plt.subplot(2, 2, i+1)\n","        # Plot last 3 actual values\n","        plt.plot(dates, actual[:, i], label='Actual (Historical)', marker='o', color='blue', linewidth=2)\n","\n","        # Plot predicted values\n","        for model in ['Prophet', 'Multivariate LSTM']:\n","            model_preds = player_predictions[\n","                (player_predictions['metric'] == metric) & (player_predictions['model'] == model)\n","            ]\n","            if not model_preds.empty:\n","                predicted = model_preds[['predicted_t+1', 'predicted_t+2']].values.flatten()\n","                plt.plot(future_dates, predicted, label=f'Forecast ({model})',\n","                         marker='x', linestyle='--', linewidth=2,\n","                         color='red' if model == 'Prophet' else 'green')\n","\n","        plt.title(f'{metric.capitalize()} Forecast for {player_name}', fontsize=12)\n","        plt.xlabel('Date', fontsize=10)\n","        plt.ylabel(metric.capitalize(), fontsize=10)\n","        plt.legend(fontsize=9)\n","        plt.grid(True)\n","        plt.xticks(rotation=45, fontsize=9)\n","        plt.tight_layout()\n","\n","    plt.suptitle(f'Forecasted Metrics for {player_name}', fontsize=14, y=1.02)\n","    plt.savefig(f'/content/tactic_sense/plots/{player_name}_forecast_timeseries.png')\n","    plt.show()  # Display inline\n","    print(f\"Saved forecast time-series plot for {player_name}\", flush=True)\n","\n","# Visualization 2: Comparative bar plots for predicted values across players\n","for metric in ['form_score', 'goals', 'assists', 'fitness_level']:\n","    plt.figure(figsize=(12, 8))\n","    bar_data = []\n","\n","    for player_id in player_ids:\n","        player_name = ts_df[ts_df['player_id'] == player_id]['full_name'].iloc[0]\n","        player_predictions = predictions_df[predictions_df['player_id'] == player_id]\n","\n","        for model in ['Prophet', 'Multivariate LSTM']:\n","            model_preds = player_predictions[\n","                (player_predictions['metric'] == metric) & (player_predictions['model'] == model)\n","            ]\n","            if not model_preds.empty:\n","                t1, t2 = model_preds[['predicted_t+1', 'predicted_t+2']].values.flatten()\n","                bar_data.append({\n","                    'player': player_name,\n","                    'model': model,\n","                    'time_step': 't+1',\n","                    'value': t1\n","                })\n","                bar_data.append({\n","                    'player': player_name,\n","                    'model': model,\n","                    'time_step': 't+2',\n","                    'value': t2\n","                })\n","\n","    bar_df = pd.DataFrame(bar_data)\n","    if bar_df.empty:\n","        print(f\"No predictions available for {metric}, skipping bar plot.\", flush=True)\n","        continue\n","\n","    sns.barplot(data=bar_df, x='player', y='value', hue='model',\n","                dodge=True, palette={'Prophet': 'red', 'Multivariate LSTM': 'green'},\n","                capsize=0.1, alpha=0.8)\n","\n","    plt.title(f'Forecasted {metric.capitalize()} for All Players (t+1 and t+2)', fontsize=14)\n","    plt.xlabel('Player', fontsize=12)\n","    plt.ylabel(f'Predicted {metric.capitalize()}', fontsize=12)\n","    plt.legend(title='Model', fontsize=10)\n","    plt.xticks(rotation=45, fontsize=10)\n","    plt.tight_layout()\n","    plt.savefig(f'/content/tactic_sense/plots/{metric}_forecast_barplot.png')\n","    plt.show()  # Display inline\n","    print(f\"Saved bar plot for {metric}\", flush=True)\n","\n","# Visualization 3: Slope graph for forecasting trends\n","slope_data = []\n","for metric in ['form_score', 'goals', 'assists', 'fitness_level']:\n","    for player_id in player_ids:\n","        player_name = ts_df[ts_df['player_id'] == player_id]['full_name'].iloc[0]\n","        player_predictions = predictions_df[predictions_df['player_id'] == player_id]\n","\n","        for model in ['Prophet', 'Multivariate LSTM']:\n","            model_preds = player_predictions[\n","                (player_predictions['metric'] == metric) & (player_predictions['model'] == model)\n","            ]\n","            if not model_preds.empty:\n","                t1, t2 = model_preds[['predicted_t+1', 'predicted_t+2']].values.flatten()\n","                slope_data.append({\n","                    'metric': metric,\n","                    'player': player_name,\n","                    'model': model,\n","                    'time_step': 't+1',\n","                    'value': t1\n","                })\n","                slope_data.append({\n","                    'metric': metric,\n","                    'player': player_name,\n","                    'model': model,\n","                    'time_step': 't+2',\n","                    'value': t2\n","                })\n","\n","slope_df = pd.DataFrame(slope_data)\n","\n","# Create slope graph\n","g = sns.FacetGrid(slope_df, col='metric', row='model', height=4, aspect=1.5, margin_titles=True)\n","g.map_dataframe(lambda data, color: plt.plot(\n","    data['time_step'], data['value'], marker='o', linewidth=2, label=data['player'].iloc[0]\n","))\n","g.add_legend(title='Player')\n","g.set_axis_labels('Time Step', 'Predicted Value')\n","g.set_titles(col_template='{col_name}', row_template='{row_name}')\n","for ax in g.axes.flat:\n","    ax.grid(True)\n","g.tight_layout()\n","g.savefig('/content/tactic_sense/plots/forecast_trends_slope_graph.png')\n","g.figure.show()  # Display inline\n","print(\"Slope graph for forecasting trends saved to /content/tactic_sense/plots/forecast_trends_slope_graph.png\", flush=True)\n","\n","print(\"\\nModel testing and visualization completed.\", flush=True)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"oelsMmpJlzxm","executionInfo":{"status":"ok","timestamp":1745899442672,"user_tz":-60,"elapsed":18286,"user":{"displayName":"Mouheb Hidouri","userId":"07062123680263574832"}},"outputId":"03feb7be-6acc-40ea-cad4-159fdbb97894"},"execution_count":96,"outputs":[{"output_type":"stream","name":"stdout","text":["Evaluation results saved to /content/tactic_sense/model_testing_results.csv\n","\n","Evaluation Results Summary:\n","                                     RMSE      MAE        R2\n","metric        model                                         \n","assists       Multivariate LSTM  0.706513  0.60782 -0.869035\n","              Prophet            0.804687  0.70473 -1.015242\n","fitness_level Multivariate LSTM  0.069237  0.06237       NaN\n","form_score    Multivariate LSTM  5.492316  4.47726 -2.888216\n","goals         Multivariate LSTM  0.702454  0.61712 -0.321092\n","              Prophet            0.578800  0.53064 -0.101248\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x1200 with 4 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saved forecast time-series plot for Mwila Phiri\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x1200 with 4 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saved forecast time-series plot for Seifeddine Jaziri\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x1200 with 4 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saved forecast time-series plot for Stanley Ratifo\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x1200 with 4 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saved forecast time-series plot for Vladyslav Vanat\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x1200 with 4 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saved forecast time-series plot for Abba Bala\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x800 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saved bar plot for form_score\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x800 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saved bar plot for goals\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x800 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saved bar plot for assists\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x800 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saved bar plot for fitness_level\n","Slope graph for forecasting trends saved to /content/tactic_sense/plots/forecast_trends_slope_graph.png\n","\n","Model testing and visualization completed.\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 2524.75x800 with 8 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":[],"metadata":{"id":"kuAwIOllrs6l"},"execution_count":null,"outputs":[]}]}