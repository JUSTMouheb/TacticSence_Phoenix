{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"gpuType":"T4","authorship_tag":"ABX9TyNA+92hJdZTiS/ixHkYZNaZ"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"},"accelerator":"GPU"},"cells":[{"cell_type":"markdown","source":["#Import Libraries and Set Up Environment\n","## Purpose:\n","\n","Import libraries for data processing, time-series modeling (ARIMA, Prophet), deep learning (LSTM), and evaluation.\n","Suppress warnings and set random seeds for reproducibility.\n","Ensure compatibility with the existing notebook environment."],"metadata":{"id":"uS_5ZIKwPTkP"}},{"cell_type":"code","source":["import pandas as pd\n","import numpy as np\n","import os\n","import warnings\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.metrics import mean_squared_error, mean_absolute_error\n","from statsmodels.tsa.arima.model import ARIMA\n","from prophet import Prophet\n","import torch\n","import torch.nn as nn\n","import torch.optim as optim\n","from torch.utils.data import Dataset, DataLoader\n","import joblib\n","import matplotlib.pyplot as plt\n","\n","# Suppress warnings for cleaner output\n","warnings.filterwarnings('ignore')\n","\n","# Set random seeds for reproducibility\n","np.random.seed(42)\n","torch.manual_seed(42)\n","\n","# Set Pandas options (consistent with notebook)\n","pd.set_option('future.no_silent_downcasting', True)\n","\n","print(\"Libraries imported and environment set up successfully.\", flush=True)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"a01UY6h3PVXf","executionInfo":{"status":"ok","timestamp":1745891475428,"user_tz":-60,"elapsed":13365,"user":{"displayName":"Mouheb Hidouri","userId":"07062123680263574832"}},"outputId":"8dc26411-824c-40f2-8c39-6f4b0a921bd2"},"execution_count":1,"outputs":[{"output_type":"stream","name":"stdout","text":["Libraries imported and environment set up successfully.\n"]}]},{"cell_type":"markdown","source":["#Cell 2: Load Player Dataset\n","##Purpose:\n","\n","Load the players_dataset.csv from the /content/tactic_sense/ directory, consistent with the provided notebook.\n","Verify the dataset’s structure, columns, and missing values.\n","Identify relevant columns for time-series forecasting (e.g., recent_goals, recent_assists, last_5_match_performance, fitness_level, medical_history).\n","Provide a summary to guide subsequent data preparation.\n"],"metadata":{"id":"QjXP0NvTPiNC"}},{"cell_type":"code","source":["from google.colab import drive\n","import os\n","import pandas as pd\n","\n","# Mount Google Drive\n","print(\"Mounting Google Drive...\", flush=True)\n","drive.mount('/content/drive')\n","\n","# Create local directory and copy CSV files\n","print(\"Copying dataset files...\", flush=True)\n","!mkdir -p /content/tactic_sense\n","!cp \"/content/drive/MyDrive/Tactic Sense/\"*.csv /content/tactic_sense/\n","!cp \"/content/drive/MyDrive/Tactic Sense/\"*.xlsx /content/tactic_sense/\n","# List files to confirm\n","print(\"Files in /content/tactic_sense/:\", flush=True)\n","!ls /content/tactic_sense/\n","\n","def load_player_data():\n","    print(\"Loading player dataset...\", flush=True)\n","    data_path = '/content/tactic_sense/'\n","    players_file = os.path.join(data_path, 'players_dataset.csv')\n","\n","    # Check if file exists\n","    if not os.path.exists(players_file):\n","        raise FileNotFoundError(f\"Players file not found: {players_file}\")\n","\n","    # Load dataset\n","    players_df = pd.read_csv(players_file)\n","\n","    # Print dataset info\n","    print(f\"Players shape: {players_df.shape}\", flush=True)\n","    print(\"Players columns:\", players_df.columns.tolist(), flush=True)\n","    print(f\"NaNs in players_df: {players_df.isna().sum().sum()}\", flush=True)\n","\n","    # Summarize key columns for performance forecasting\n","    key_columns = ['recent_goals', 'recent_assists', 'last_5_match_performance',\n","                   'fitness_level', 'medical_history']\n","    print(\"Summary of key columns:\", flush=True)\n","    for col in key_columns:\n","        if col in players_df.columns:\n","            print(f\"\\n{col}:\")\n","            print(players_df[col].describe() if players_df[col].dtype in ['float64', 'int64']\n","                  else players_df[col].value_counts().head(), flush=True)\n","        else:\n","            print(f\"{col} not found in dataset.\", flush=True)\n","\n","    return players_df\n","\n","# Run the function\n","players_df = load_player_data()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ZsMoksFTPXAz","executionInfo":{"status":"ok","timestamp":1745891594288,"user_tz":-60,"elapsed":26484,"user":{"displayName":"Mouheb Hidouri","userId":"07062123680263574832"}},"outputId":"d88df379-bb32-42ec-fb09-d3481846781d"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounting Google Drive...\n","Mounted at /content/drive\n","Copying dataset files...\n","Files in /content/tactic_sense/:\n","clubs_dataset.csv\t\t  player_club_recommendations.csv\n","communication_boxes_dataset.csv   players_dataset.csv\n","equipment_suppliers_dataset.csv   predicted_pairs.csv\n","fitness_clubs_dataset.xlsx\t  recruiting_agents_dataset.csv\n","managers_and_staff_dataset.csv\t  service_providers_dataset.csv\n","pairs_df.csv\t\t\t  sponsors_dataset.csv\n","pairs_df_with_predictions.csv\t  sports_clothing_brands_dataset.csv\n","pairs_df_with_predictions_v3.csv  sports_management_agencies_dataset.csv\n","player_agent_dataset.csv\t  travel_agencies_dataset.csv\n","Loading player dataset...\n","Players shape: (948, 54)\n","Players columns: ['player_id', 'full_name', 'email', 'date_of_birth', 'age', 'nationality', 'position', 'secondary_position', 'club', 'league', 'market_value_eur', 'contract_status', 'fitness_level', 'medical_history', 'last_5_match_performance', 'skills_rating', 'weaknesses', 'goals', 'assists', 'preferred_foot', 'verified_status', 'likes_from_pros', 'scouting_score', 'tactic_fit_score', 'career_path_suggestions', 'training_recommendations', 'profile_rating', 'created_at', 'yellow_cards', 'red_cards', 'matches_suspended', 'goal_contributions', 'discipline_score', 'value_category', 'age_group', 'skill_handling', 'skill_reflexes', 'skill_positioning', 'skill_finishing', 'skill_dribbling', 'skill_speed', 'skill_passing', 'skill_vision', 'skill_tackling', 'skill_marking', 'skill_heading', 'recent_goals', 'recent_assists', 'Coach_Rating', 'Agent_Score', 'Scout_Comment', 'Scout_Comment_Score', 'Scout_Sentiment_Score', 'Expert_Score']\n","NaNs in players_df: 0\n","Summary of key columns:\n","\n","recent_goals:\n","count    948.000000\n","mean       3.138186\n","std        2.818122\n","min        0.000000\n","25%        0.000000\n","50%        3.000000\n","75%        5.000000\n","max       10.000000\n","Name: recent_goals, dtype: float64\n","\n","recent_assists:\n","count    948.000000\n","mean       3.229958\n","std        2.828776\n","min        0.000000\n","25%        0.000000\n","50%        4.000000\n","75%        6.000000\n","max       10.000000\n","Name: recent_assists, dtype: float64\n","\n","last_5_match_performance:\n","last_5_match_performance\n","{'match_1': {'goals': 0, 'assists': 0}, 'match_2': {'goals': 0, 'assists': 0}, 'match_3': {'goals': 0, 'assists': 0}, 'match_4': {'goals': 0, 'assists': 0}, 'match_5': {'goals': 0, 'assists': 0}}    347\n","{'match_1': {'goals': 0, 'assists': 2}, 'match_2': {'goals': 1, 'assists': 2}, 'match_3': {'goals': 0, 'assists': 0}, 'match_4': {'goals': 1, 'assists': 0}, 'match_5': {'goals': 1, 'assists': 1}}      2\n","{'match_1': {'goals': 0, 'assists': 1}, 'match_2': {'goals': 0, 'assists': 1}, 'match_3': {'goals': 2, 'assists': 0}, 'match_4': {'goals': 2, 'assists': 0}, 'match_5': {'goals': 1, 'assists': 0}}      2\n","{'match_1': {'goals': 1, 'assists': 1}, 'match_2': {'goals': 2, 'assists': 1}, 'match_3': {'goals': 2, 'assists': 1}, 'match_4': {'goals': 1, 'assists': 1}, 'match_5': {'goals': 2, 'assists': 0}}      2\n","{'match_1': {'goals': 1, 'assists': 0}, 'match_2': {'goals': 1, 'assists': 2}, 'match_3': {'goals': 0, 'assists': 1}, 'match_4': {'goals': 0, 'assists': 0}, 'match_5': {'goals': 1, 'assists': 2}}      2\n","Name: count, dtype: int64\n","\n","fitness_level:\n","count    948.000000\n","mean      85.092099\n","std        8.579371\n","min       70.000000\n","25%       77.707500\n","50%       85.410000\n","75%       92.337500\n","max       99.970000\n","Name: fitness_level, dtype: float64\n","\n","medical_history:\n","medical_history\n","No recent injuries                              685\n","Minor injury: Expected recovery in 1-2 weeks    185\n","Major injury: Out for season                     78\n","Name: count, dtype: int64\n"]}]},{"cell_type":"markdown","source":["# Create Time-Series Dataset\n","##Purpose:\n","\n","Transform the player dataset into a time-series format suitable for forecasting.\n","Parse last_5_match_performance to extract match-by-match goals and assists for each player.\n","Assign synthetic timestamps (e.g., weekly intervals) to create a chronological sequence.\n","Include fitness_level and medical_history as covariates.\n","Engineer a composite form_score (e.g., based on goals and assists) as the primary metric to forecast.\n","Save the time-series dataset for reproducibility."],"metadata":{"id":"t-7yRteMQLwg"}},{"cell_type":"code","source":["import pandas as pd\n","import json\n","from datetime import datetime, timedelta\n","\n","def create_time_series_data(players_df):\n","    print(\"Creating time-series dataset...\", flush=True)\n","\n","    # Select relevant columns\n","    cols = ['player_id', 'full_name', 'last_5_match_performance', 'fitness_level', 'medical_history']\n","    ts_df = players_df[cols].copy()\n","\n","    # Parse last_5_match_performance (JSON-like strings)\n","    def parse_match_performance(perf_str):\n","        try:\n","            # Replace single quotes with double quotes for valid JSON\n","            perf_str = perf_str.replace(\"'\", \"\\\"\")\n","            perf_dict = json.loads(perf_str)\n","            # Extract goals and assists for each match\n","            matches = []\n","            for match in ['match_1', 'match_2', 'match_3', 'match_4', 'match_5']:\n","                if match in perf_dict:\n","                    matches.append({\n","                        'goals': perf_dict[match]['goals'],\n","                        'assists': perf_dict[match]['assists']\n","                    })\n","                else:\n","                    matches.append({'goals': 0, 'assists': 0})\n","            return matches\n","        except (json.JSONDecodeError, KeyError) as e:\n","            print(f\"Error parsing performance: {e}. Returning zeros.\", flush=True)\n","            return [{'goals': 0, 'assists': 0}] * 5\n","\n","    # Apply parsing\n","    ts_df['matches'] = ts_df['last_5_match_performance'].apply(parse_match_performance)\n","\n","    # Encode medical_history (0: No injury, 1: Minor, 2: Major)\n","    medical_mapping = {\n","        'No recent injuries': 0,\n","        'Minor injury: Expected recovery in 1-2 weeks': 1,\n","        'Major injury: Out for season': 2\n","    }\n","    ts_df['injury_history'] = ts_df['medical_history'].map(medical_mapping).fillna(0).astype(int)\n","\n","    # Create time-series records\n","    time_series_data = []\n","    start_date = datetime(2024, 1, 1)  # Arbitrary start date\n","    match_dates = [start_date + timedelta(weeks=i) for i in range(5)]  # Weekly matches\n","\n","    for _, row in ts_df.iterrows():\n","        player_id = row['player_id']\n","        full_name = row['full_name']\n","        fitness_level = row['fitness_level']\n","        injury_history = row['injury_history']\n","        matches = row['matches']\n","\n","        for i, (match, date) in enumerate(zip(matches, match_dates)):\n","            # Calculate form_score (weighted sum of goals and assists)\n","            form_score = (0.6 * match['goals'] + 0.4 * match['assists']) * 10  # Scaled for clarity\n","            time_series_data.append({\n","                'player_id': player_id,\n","                'full_name': full_name,\n","                'date': date,\n","                'form_score': form_score,\n","                'goals': match['goals'],\n","                'assists': match['assists'],\n","                'fitness_level': fitness_level,\n","                'injury_history': injury_history\n","            })\n","\n","    # Create DataFrame\n","    ts_df = pd.DataFrame(time_series_data)\n","\n","    # Print dataset info\n","    print(f\"Time-series data shape: {ts_df.shape}\", flush=True)\n","    print(\"Columns:\", ts_df.columns.tolist(), flush=True)\n","    print(f\"NaNs in ts_df: {ts_df.isna().sum().sum()}\", flush=True)\n","    print(\"Form score summary:\\n\", ts_df['form_score'].describe(), flush=True)\n","    print(\"Sample rows:\\n\", ts_df.head().to_string(), flush=True)\n","\n","    # Save dataset\n","    ts_df.to_csv('/content/tactic_sense/player_time_series.csv', index=False)\n","    print(\"Time-series dataset saved to /content/tactic_sense/player_time_series.csv\", flush=True)\n","\n","    return ts_df\n","\n","# Run the function\n","ts_df = create_time_series_data(players_df)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"c5zYFw7xPlV8","executionInfo":{"status":"ok","timestamp":1745891661592,"user_tz":-60,"elapsed":110,"user":{"displayName":"Mouheb Hidouri","userId":"07062123680263574832"}},"outputId":"0ad0891b-db32-4493-ec80-f01587f45dfd"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["Creating time-series dataset...\n","Time-series data shape: (4740, 8)\n","Columns: ['player_id', 'full_name', 'date', 'form_score', 'goals', 'assists', 'fitness_level', 'injury_history']\n","NaNs in ts_df: 0\n","Form score summary:\n"," count    4740.000000\n","mean        6.349789\n","std         6.718405\n","min         0.000000\n","25%         0.000000\n","50%         4.000000\n","75%        12.000000\n","max        20.000000\n","Name: form_score, dtype: float64\n","Sample rows:\n","    player_id     full_name       date  form_score  goals  assists  fitness_level  injury_history\n","0          1  Mamadou Diop 2024-01-01         0.0      0        0          90.86               0\n","1          1  Mamadou Diop 2024-01-08         0.0      0        0          90.86               0\n","2          1  Mamadou Diop 2024-01-15         0.0      0        0          90.86               0\n","3          1  Mamadou Diop 2024-01-22         0.0      0        0          90.86               0\n","4          1  Mamadou Diop 2024-01-29         0.0      0        0          90.86               0\n","Time-series dataset saved to /content/tactic_sense/player_time_series.csv\n"]}]},{"cell_type":"markdown","source":["Cell 4: Refined Prophet Forecasting for a Sample Player"],"metadata":{"id":"K2ugjjYFQb_0"}},{"cell_type":"code","source":["from prophet import Prophet\n","import pandas as pd\n","import numpy as np\n","\n","def train_prophet(player_ts, forecast_steps=2):\n","    print(f\"Training Prophet for player: {player_ts['full_name'].iloc[0]}...\", flush=True)\n","    # Prepare data for Prophet\n","    df_prophet = player_ts[['date', 'form_score', 'fitness_level', 'injury_history']].rename(\n","        columns={'date': 'ds', 'form_score': 'y', 'fitness_level': 'fitness_level', 'injury_history': 'injury_history'}\n","    )\n","\n","    # Check for sufficient variance\n","    if df_prophet['y'].std() < 1e-5:\n","        print(\"Warning: Form score has near-zero variance. Skipping Prophet.\", flush=True)\n","        return None, None\n","\n","    try:\n","        # Initialize Prophet with linear growth and no seasonality\n","        model = Prophet(\n","            growth='linear',\n","            yearly_seasonality=False,\n","            weekly_seasonality=False,\n","            daily_seasonality=False\n","        )\n","        # Add regressors\n","        model.add_regressor('fitness_level')\n","        model.add_regressor('injury_history')\n","\n","        # Fit model\n","        model.fit(df_prophet)\n","\n","        # Create future dataframe\n","        future = model.make_future_dataframe(periods=forecast_steps, freq='W')\n","        # Extend regressors (use last known values)\n","        future['fitness_level'] = df_prophet['fitness_level'].iloc[-1]\n","        future['injury_history'] = df_prophet['injury_history'].iloc[-1]\n","\n","        # Forecast\n","        forecast = model.predict(future)\n","        # Ensure non-negative predictions\n","        forecast_values = np.maximum(forecast['yhat'].values[-forecast_steps:], 0)\n","\n","        # Print forecast\n","        print(f\"Prophet forecast for next {forecast_steps} matches: {forecast_values}\", flush=True)\n","        return forecast_values, model\n","    except Exception as e:\n","        print(f\"Prophet failed: {e}\", flush=True)\n","        return None, None\n","\n","# Select a player with non-zero form_score\n","print(\"Selecting player with non-zero form_score...\", flush=True)\n","player_max_scores = ts_df.groupby('player_id')['form_score'].max()\n","non_zero_players = player_max_scores[player_max_scores > 0].index\n","if len(non_zero_players) == 0:\n","    raise ValueError(\"No players with non-zero form_score found.\")\n","sample_player_id = non_zero_players[0]  # Take first non-zero player\n","sample_player_ts = ts_df[ts_df['player_id'] == sample_player_id].sort_values('date')\n","\n","# Print player info\n","print(f\"Selected player: {sample_player_ts['full_name'].iloc[0]} (ID: {sample_player_id})\", flush=True)\n","print(\"Player time-series data:\\n\", sample_player_ts[['date', 'form_score', 'goals', 'assists']].to_string(index=False), flush=True)\n","\n","# Run Prophet\n","prophet_forecast, prophet_model = train_prophet(sample_player_ts)\n","\n","# Save model if successful\n","if prophet_model is not None:\n","    joblib.dump(prophet_model, '/content/tactic_sense/prophet_model.pkl')\n","    print(\"Prophet model saved to /content/tactic_sense/prophet_model.pkl\", flush=True)\n","else:\n","    print(\"No Prophet model saved due to failure or zero variance.\", flush=True)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"gXfduu2OQJWe","executionInfo":{"status":"ok","timestamp":1745896161281,"user_tz":-60,"elapsed":243,"user":{"displayName":"Mouheb Hidouri","userId":"07062123680263574832"}},"outputId":"66ba5e89-bab6-48ac-d744-0d8f66fa7b9a"},"execution_count":64,"outputs":[{"output_type":"stream","name":"stdout","text":["Selecting player with non-zero form_score...\n","Selected player: Vladyslav Vanat (ID: 24)\n","Player time-series data:\n","       date  form_score  goals  assists\n","2024-01-01        14.0      1        2\n","2024-01-08        20.0      2        2\n","2024-01-15         0.0      0        0\n","2024-01-22        14.0      1        2\n","2024-01-29        16.0      2        1\n","Training Prophet for player: Vladyslav Vanat...\n"]},{"output_type":"stream","name":"stderr","text":["INFO:prophet:n_changepoints greater than number of observations. Using 3.\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/62954j_j.json\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/o3e23umi.json\n","DEBUG:cmdstanpy:idx 0\n","DEBUG:cmdstanpy:running CmdStan, num_threads: None\n","DEBUG:cmdstanpy:CmdStan args: ['/usr/local/lib/python3.11/dist-packages/prophet/stan_model/prophet_model.bin', 'random', 'seed=91060', 'data', 'file=/tmp/tmpl71otz8y/62954j_j.json', 'init=/tmp/tmpl71otz8y/o3e23umi.json', 'output', 'file=/tmp/tmpl71otz8y/prophet_modelgxqca0ex/prophet_model-20250429030918.csv', 'method=optimize', 'algorithm=newton', 'iter=10000']\n","03:09:18 - cmdstanpy - INFO - Chain [1] start processing\n","INFO:cmdstanpy:Chain [1] start processing\n","03:09:18 - cmdstanpy - INFO - Chain [1] done processing\n","INFO:cmdstanpy:Chain [1] done processing\n"]},{"output_type":"stream","name":"stdout","text":["Prophet forecast for next 2 matches: [12.23459603 12.03627003]\n","Prophet model saved to /content/tactic_sense/prophet_model.pkl\n"]}]},{"cell_type":"markdown","source":["Cell 5: Prophet Forecasting for Multiple Players\n","(Replaces old Cell 8. Extends Prophet to multiple players and evaluates performance.)"],"metadata":{"id":"ulREEj0aQl6Y"}},{"cell_type":"code","source":["import pandas as pd\n","import numpy as np\n","from sklearn.metrics import mean_squared_error\n","\n","# Filter players with non-zero variance\n","print(\"Filtering players with non-zero form_score variance...\", flush=True)\n","player_stats = ts_df.groupby('player_id').agg({'form_score': 'std', 'full_name': 'first'}).reset_index()\n","non_zero_players = player_stats[player_stats['form_score'] > 1e-5]['player_id'].values\n","print(f\"Found {len(non_zero_players)} players with non-zero variance.\", flush=True)\n","\n","# Forecast for multiple players (up to 10)\n","results = []\n","max_players = 10\n","player_ids = non_zero_players[:max_players]\n","\n","if len(player_ids) == 0:\n","    print(\"No players with non-zero form_score variance found.\", flush=True)\n","else:\n","    for player_id in player_ids:\n","        player_ts = ts_df[ts_df['player_id'] == player_id].sort_values('date')\n","        player_name = player_ts['full_name'].iloc[0]\n","\n","        # Train/test split\n","        train_ts = player_ts.iloc[:3]\n","        test_ts = player_ts.iloc[3:]\n","        test_actual = test_ts['form_score'].values\n","\n","        print(f\"\\nProcessing {player_name} (ID: {player_id})...\", flush=True)\n","\n","        # Run Prophet\n","        prophet_forecast, _ = train_prophet(train_ts, forecast_steps=2)\n","\n","        # Compute RMSE\n","        rmse = None\n","        if prophet_forecast is not None:\n","            rmse = np.sqrt(mean_squared_error(test_actual, prophet_forecast))\n","\n","        # Store results\n","        results.append({\n","            'player_id': player_id,\n","            'full_name': player_name,\n","            'Prophet_RMSE': rmse,\n","            'Test_Actual': test_actual.tolist(),\n","            'Prophet_Predicted': prophet_forecast.tolist() if prophet_forecast is not None else None\n","        })\n","\n","# Create and print results\n","if results:\n","    results_df = pd.DataFrame(results)\n","    print(\"\\nSummary of Prophet RMSE across players:\")\n","    print(results_df[['full_name', 'Prophet_RMSE']].to_string(index=False), flush=True)\n","\n","    # Compute average RMSE\n","    avg_rmse = results_df['Prophet_RMSE'].mean()\n","    print(f\"\\nAverage Prophet RMSE across players: {avg_rmse:.4f}\", flush=True)\n","\n","    # Save results\n","    results_df.to_csv('/content/tactic_sense/multi_player_prophet_results.csv', index=False)\n","    print(\"Results saved to /content/tactic_sense/multi_player_prophet_results.csv\", flush=True)\n","else:\n","    print(\"No results to display: All selected players had zero variance.\", flush=True)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"e-ZfhWSGQbDU","executionInfo":{"status":"ok","timestamp":1745896195571,"user_tz":-60,"elapsed":2577,"user":{"displayName":"Mouheb Hidouri","userId":"07062123680263574832"}},"outputId":"631021e8-8bbb-43dd-d664-cc9d44eed56a"},"execution_count":65,"outputs":[{"output_type":"stream","name":"stdout","text":["Filtering players with non-zero form_score variance...\n","Found 601 players with non-zero variance.\n","\n","Processing Vladyslav Vanat (ID: 24)...\n","Training Prophet for player: Vladyslav Vanat...\n"]},{"output_type":"stream","name":"stderr","text":["INFO:prophet:n_changepoints greater than number of observations. Using 1.\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/9xa9c2xy.json\n","DEBUG:cmdstanpy:input tempfile: /tmp/tmpl71otz8y/8i3s_q7h.json\n","DEBUG:cmdstanpy:idx 0\n","DEBUG:cmdstanpy:running CmdStan, num_